<?xml version="1.0"?>
<robot name="rocker_bogie_4wd_rover">

  <!--
    설명: 2026-10-14 제공된 최신 로버 URDF의 매핑 좌표 참고 사본. 카메라 하향 20도는 사용자 확인값.
    사용법: mapping_preflight.py sensors의 urdf 인자로 이 파일을 지정한다.
    Distribution model updated from the supplied rev5 Fusion assembly and 13 STL exports.
    STL dimensions are millimetres; every mesh reference therefore uses scale 0.001.
    Zero-pose offsets are documented in docs/offset_audit.md.
  -->

  <!-- Main chassis; lid is included in this body. Camera and IMU are separate links. -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.008015853218 0.003240341788 -0.025673826811" rpy="0 0 0"/>
      <mass value="0.847900053986"/>
      <inertia ixx="0.002302831138" ixy="-0.000113581036669" ixz="0.000108137936490"
               iyy="0.004180321839" iyz="0.000015141466736" izz="0.005334787938"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>

  <!-- The real central bevel gear is not a separate simulated body. The passive
       right rocker mirrors the left rocker 1:1. -->
  <link name="left_rocker_arm">
    <inertial>
      <origin xyz="0.000041281766 0.055638256545 -0.022265167017" rpy="0 0 0"/>
      <mass value="0.186900033238"/>
      <inertia ixx="0.000095809929947" ixy="0.000000472580802" ixz="-0.000000167203869"
               iyy="0.001204701265" iyz="0.000027487080501" izz="0.001220632439"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/arm_l_link.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/arm_l_link.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="left_rocker_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_rocker_arm"/>
    <origin xyz="-0.01830665319 0.06918739351 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.523598775598" upper="0.523598775598" effort="100" velocity="3.0"/>
    <dynamics damping="0.01"/>
  </joint>

  <!-- Right rocker arm. -->
  <link name="right_rocker_arm">
    <inertial>
      <origin xyz="0.000045263438 -0.055653675439 -0.022209589971" rpy="0 0 0"/>
      <mass value="0.186899954875"/>
      <inertia ixx="0.000095650905168" ixy="-0.000000408041754" ixz="-0.000000163472263"
               iyy="0.001202966667" iyz="-0.000027393035014" izz="0.001218553662"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/arm_r_link.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/arm_r_link.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="right_rocker_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_rocker_arm"/>
    <origin xyz="-0.01830665319 -0.06918739351 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.523598775598" upper="0.523598775598" effort="100" velocity="3.0"/>
    <dynamics damping="0.01"/>
    <mimic joint="left_rocker_joint" multiplier="-1" offset="0"/>
  </joint>

  <!-- Front-left steering/leg link, using wheel_link_1 physical properties. -->
  <link name="fl_leg">
    <inertial>
      <origin xyz="0.006757812092 0.037123406320 -0.066878858232" rpy="0 0 0"/>
      <mass value="0.225299994110"/>
      <inertia ixx="0.000117798243071" ixy="-0.000000391472486" ixz="0.000005555278691"
               iyy="0.000079323177632" iyz="0.000007931530746" izz="0.000076905189285"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_link_1.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_link_1.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="fl_steering_joint" type="revolute">
    <parent link="left_rocker_arm"/><child link="fl_leg"/>
    <origin xyz="0.10243139721 0.06331260649 -0.04531324865" rpy="0 0 3.14159265359"/>
    <axis xyz="0 0 -1"/><limit lower="-1.745329251994" upper="1.745329251994" effort="50" velocity="3.0"/>
  </joint>

  <!-- Rear-left steering/leg link, using wheel_link_3 physical properties. -->
  <link name="rl_leg">
    <inertial>
      <origin xyz="-0.006757812092 -0.037123406320 -0.066878858232" rpy="0 0 0"/>
      <mass value="0.225299994110"/>
      <inertia ixx="0.000117798243071" ixy="-0.000000391472486" ixz="-0.000005555278691"
               iyy="0.000079323177632" iyz="-0.000007931530746" izz="0.000076905189285"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_link_3.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_link_3.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="rl_steering_joint" type="revolute">
    <parent link="left_rocker_arm"/><child link="rl_leg"/>
    <origin xyz="-0.10243139721 0.06331260649 -0.04531324865" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/><limit lower="-1.745329251994" upper="1.745329251994" effort="50" velocity="3.0"/>
  </joint>

  <!-- Front-right steering/leg link, using wheel_link_2 physical properties. -->
  <link name="rr_leg">
    <inertial>
      <origin xyz="0.006757812092 0.037123406320 -0.066878858232" rpy="0 0 0"/>
      <mass value="0.225299994110"/>
      <inertia ixx="0.000117798243071" ixy="-0.000000391472486" ixz="0.000005555278691"
               iyy="0.000079323177632" iyz="0.000007931530746" izz="0.000076905189285"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_link_2.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_link_2.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="rr_steering_joint" type="revolute">
    <parent link="right_rocker_arm"/><child link="fr_leg"/>
    <origin xyz="0.10243139721 -0.06331260649 -0.04531324865" rpy="0 0 3.14159265359"/>
    <axis xyz="0 0 -1"/><limit lower="-1.745329251994" upper="1.745329251994" effort="50" velocity="3.0"/>
  </joint>

  <!-- Rear-right steering/leg link, using wheel_link_4 physical properties. -->
  <link name="fr_leg">
    <inertial>
      <origin xyz="-0.006757812092 -0.037123406320 -0.066878858232" rpy="0 0 0"/>
      <mass value="0.225299994110"/>
      <inertia ixx="0.000117798243071" ixy="-0.000000391472486" ixz="-0.000005555278691"
               iyy="0.000079323177632" iyz="-0.000007931530746" izz="0.000076905189285"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_link_4.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_link_4.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="fr_steering_joint" type="revolute">
    <parent link="right_rocker_arm"/><child link="rr_leg"/>
    <origin xyz="-0.10243139721 -0.06331260649 -0.04531324865" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/><limit lower="-1.745329251994" upper="1.745329251994" effort="50" velocity="3.0"/>
  </joint>

  <!-- Wheels: origins at the supplied steering-to-wheel offsets; axes preserve previous URDF choice. -->
  <link name="fl_wheel">
    <inertial><origin xyz="0.000105436252 0.009184841148 0.000000044891" rpy="0 0 0"/><mass value="0.049700283757"/>
      <inertia ixx="0.000036112445366" ixy="0.000000021731779" ixz="-0.000000000038044" iyy="0.000062381899087" iyz="0.000000000021673" izz="0.000035915321601"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_1.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_1.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="fl_wheel_joint" type="continuous"><parent link="fl_leg"/><child link="fl_wheel"/><origin xyz="0 0 -0.0705" rpy="0 0 3.14159265359"/><axis xyz="0 -1 0"/></joint>

  <link name="fr_wheel">
    <inertial><origin xyz="0.000105436252 0.009184841148 0.000000044891" rpy="0 0 0"/><mass value="0.049700283757"/>
      <inertia ixx="0.000036112445366" ixy="0.000000021731779" ixz="-0.000000000038044" iyy="0.000062381899087" iyz="0.000000000021673" izz="0.000035915321601"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_2.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_2.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="fr_wheel_joint" type="continuous"><parent link="fr_leg"/><child link="fr_wheel"/><origin xyz="0 0 -0.0705" rpy="0 0 0"/><axis xyz="0 -1 0"/></joint>

  <link name="rl_wheel">
    <inertial><origin xyz="-0.000105517419 -0.009184812442 -0.000000000426" rpy="0 0 0"/><mass value="0.049700327360"/>
      <inertia ixx="0.000036112478572" ixy="0.000000021752632" ixz="-0.000000000012088" iyy="0.000062381919386" iyz="-0.000000000001085" izz="0.000035915338505"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_3.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_3.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="rl_wheel_joint" type="continuous"><parent link="rl_leg"/><child link="rl_wheel"/><origin xyz="0 0 -0.0705" rpy="0 0 3.14159265359"/><axis xyz="0 1 0"/></joint>

  <link name="rr_wheel">
    <inertial><origin xyz="-0.000105517419 -0.009184812442 -0.000000000426" rpy="0 0 0"/><mass value="0.049700327360"/>
      <inertia ixx="0.000036112478572" ixy="0.000000021752632" ixz="-0.000000000012088" iyy="0.000062381919386" iyz="-0.000000000001085" izz="0.000035915338505"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_4.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/wheel_4.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="rr_wheel_joint" type="continuous"><parent link="rr_leg"/><child link="rr_wheel"/><origin xyz="0 0 -0.0705" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>

  <!-- IMU link is fixed to the chassis. The origin is the measured IMU reference point. -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0.000039949849 0.000108307373 -0.002011729835" rpy="0 0 0"/>
      <mass value="0.002400000279"/>
      <inertia ixx="0.000000056092954" ixy="-0.000000000148781" ixz="-0.000000000114852"
               iyy="0.000000136628269" iyz="-0.000000000005384" izz="0.000000188602298"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/IMU.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/IMU.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="-0.01800665319 0 -0.021473" rpy="0 0 0"/>
  </joint>

  <!-- Camera assembly, pitched 20 degrees about +Y at the CAD mount origin. -->
  <link name="camera_link">
    <inertial>
      <origin xyz="-0.011811875567 0.008683428205 0.004231746168" rpy="0 0 0"/>
      <mass value="0.073299981594"/>
      <inertia ixx="0.000045771873705" ixy="0.000000388879236" ixz="0.000000069330944"
               iyy="0.000006626435639" iyz="-0.000000147048200" izz="0.000045944278179"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/Camera.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://rocker_bogie_4wd_rover/meshes/Camera.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.12498574268 0.00747451631 0.01521787607" rpy="0 0.349066 0"/>
  </joint>

  <!-- Stereo optical frames (baseline 50 mm): X right, Y down, Z forward. Assumes camera_link X points along lens-forward.
       Left camera is at camera_link +Y 17.5 mm, right camera at -Y 32.5 mm. -->
  <link name="camera_left_optical_frame"/>
  <joint name="camera_to_left_optical_frame" type="fixed">
    <parent link="camera_link"/><child link="camera_left_optical_frame"/>
    <origin xyz="0 0.0175 0" rpy="-1.570796326795 0 -1.570796326795"/>
  </joint>

  <link name="camera_right_optical_frame"/>
  <joint name="camera_to_right_optical_frame" type="fixed">
    <parent link="camera_link"/><child link="camera_right_optical_frame"/>
    <origin xyz="0 -0.0325 0" rpy="-1.570796326795 0 -1.570796326795"/>
  </joint>

</robot>
